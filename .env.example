GENERIC_TIMEZONE=Asia/Karachi
N8N_PORT=5677
WEBHOOK_URL=http://localhost:5677/

# HMAC for inbound job.closed (must match backend WEBHOOK_SECRET, min 16 chars)
WEBHOOK_SECRET=change-me-to-a-long-random-webhook-secret
SITEPROOF_WEBHOOK_SECRET=change-me-to-a-long-random-webhook-secret

# Calls TO SiteProof API (must match backend N8N_API_KEY)
N8N_API_KEY=change-me-to-a-long-random-n8n-api-key
SITEPROOF_API_URL=http://host.docker.internal:3000/api/v1

# Dashboard origin for email/Slack/Sheet links: {ADMIN_ORIGIN}/jobs/{jobId}
ADMIN_ORIGIN=http://localhost:5173
SITEPROOF_ADMIN_URL=http://localhost:5173

SITEPROOF_SUPERVISOR_EMAIL=supervisor@siteproof.local
SITEPROOF_FROM_EMAIL=alerts@siteproof.local
SITEPROOF_SLACK_WEBHOOK=
SITEPROOF_SHEET_ID=
SITEPROOF_SHEET_TAB=Job Outcomes

# Google OAuth (optional — usually created in n8n UI instead)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Match credential names already created in n8n UI
N8N_GMAIL_CREDENTIAL_NAME=Gmail account
N8N_SHEETS_CREDENTIAL_NAME=Google Sheets account

SITEPROOF_PDF_API_URL=http://gotenberg:3000/forms/chromium/convert/html
SITEPROOF_ORG_NAME=KeepCodeIn Solar
SITEPROOF_LOGO_URL=
SITEPROOF_PRIMARY_COLOR=#0B3D2E

# Cloudinary — PDF hosting for report-ready
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=siteproof/reports

# After editing .env, bake values into workflows:
#   node scripts/generate-workflows.js
# then sync/import. Code nodes use literals, not $env.
# Never commit .env. Before pushing workflow JSON, regenerate from placeholders
# if you baked real secrets: ENV_FILE=.env.example node scripts/generate-workflows.js
